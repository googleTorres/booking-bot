# Token from @BotFather
BOT_TOKEN=123456:ABC-your-token

# Telegram user IDs of the business owner/managers (JSON list). Get yours from @userinfobot
OWNER_IDS=[123456789]

# Local run uses SQLite. docker-compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///bot.db

# Business
BUSINESS_NAME=Demo Barbershop
TIMEZONE=Europe/London
WORK_DAYS=[0,1,2,3,4,5]
WORK_START=10:00
WORK_END=20:00
SLOT_STEP_MINUTES=30
BOOKING_DAYS_AHEAD=7
MIN_LEAD_MINUTES=60

# Payments: @BotFather → your bot → Payments → Stripe (TEST first). Empty = no deposits.
PAYMENT_PROVIDER_TOKEN=
CURRENCY=USD
PENDING_PAYMENT_MINUTES=15
FREE_CANCEL_HOURS=24

# Reviews: clients who rate 4–5 stars get this link
REVIEW_URL=https://g.page/r/your-google-review-link
REVIEW_DELAY_MINUTES=120

# Create sample services and staff on first start
SEED_DEMO=true
